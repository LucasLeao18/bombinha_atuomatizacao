<Window x:Class="Bombinha.App.Views.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Bombinha.App.ViewModels"
        xmlns:v="clr-namespace:Bombinha.App.Views"
        xmlns:c="clr-namespace:Bombinha.App.Ui.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Bombinha – JKLM.fun PT-BR"
        Icon="/Assets/bombinha.ico"
        Width="1160" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Topmost="{Binding AlwaysOnTop}">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================= barra lateral -->
        <DockPanel Background="{StaticResource Sidebar}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,24,20,26">
                <Grid Width="34" Height="34">
                    <Ellipse Fill="{StaticResource Accent}" />
                    <TextBlock Text="B" Foreground="White" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                </Grid>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Bombinha" Style="{StaticResource H1}" FontSize="19" />
                    <TextBlock Text="JKLM.fun PT-BR" Style="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,18">
                <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,12" />
                <TextBlock Text="F8  ·  parar tudo" Style="{StaticResource Muted}" />
                <TextBlock Text="F7  ·  trocar modo" Style="{StaticResource Muted}" />
                <TextBlock Text="F6  ·  nova partida" Style="{StaticResource Muted}" />
                <TextBlock Text="Ctrl+S  ·  salvar" Style="{StaticResource Muted}" />
                <TextBlock Text="dev @lucasleao18" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel>
                <RadioButton Style="{StaticResource NavItem}" c:UiProps.Icon="▶" Content="Principal"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter={x:Static vm:Page.Dashboard}}" />
                <RadioButton Style="{StaticResource NavItem}" c:UiProps.Icon="▤" Content="Console"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter={x:Static vm:Page.Console}}" />
                <RadioButton Style="{StaticResource NavItem}" c:UiProps.Icon="⚙" Content="Setup"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter={x:Static vm:Page.Setup}}" />
                <RadioButton Style="{StaticResource NavItem}" c:UiProps.Icon="✎" Content="Humanização"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter={x:Static vm:Page.Humanization}}" />
                <RadioButton Style="{StaticResource NavItem}" c:UiProps.Icon="▦" Content="Estatísticas"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumEq}, ConverterParameter={x:Static vm:Page.Stats}}" />
            </StackPanel>
        </DockPanel>

        <!-- ========================================================= área principal -->
        <DockPanel Grid.Column="1">
            <!-- topo -->
            <DockPanel DockPanel.Dock="Top" Margin="28,22,28,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="16" Padding="12,7" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" VerticalAlignment="Center" Fill="{StaticResource Danger}" />
                            <TextBlock x:Name="StatusLabel" AutomationProperties.AutomationId="EngineStatus" Text="{Binding StatusText}" Margin="8,0,0,0" FontWeight="SemiBold"
                                       Foreground="{StaticResource Danger}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <CheckBox Style="{StaticResource Switch}" Content="Sempre no topo" IsChecked="{Binding AlwaysOnTop}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- barra de status -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource Sidebar}" Height="30">
                <DockPanel Margin="18,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusSummary}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,18,0" />
                </DockPanel>
            </Border>

            <!-- páginas (mantidas vivas para preservar rolagem e estado) -->
            <Grid Margin="28,10,28,18">
                <v:DashboardView Visibility="{Binding CurrentPage, Converter={StaticResource EnumVis}, ConverterParameter={x:Static vm:Page.Dashboard}}" />
                <v:ConsoleView Visibility="{Binding CurrentPage, Converter={StaticResource EnumVis}, ConverterParameter={x:Static vm:Page.Console}}" />
                <v:SetupView Visibility="{Binding CurrentPage, Converter={StaticResource EnumVis}, ConverterParameter={x:Static vm:Page.Setup}}" />
                <v:HumanizationView Visibility="{Binding CurrentPage, Converter={StaticResource EnumVis}, ConverterParameter={x:Static vm:Page.Humanization}}" />
                <v:StatsView Visibility="{Binding CurrentPage, Converter={StaticResource EnumVis}, ConverterParameter={x:Static vm:Page.Stats}}" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
