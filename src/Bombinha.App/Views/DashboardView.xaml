<UserControl x:Class="Bombinha.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Bombinha.App.ViewModels"
             xmlns:c="clr-namespace:Bombinha.App.Ui.Controls"
             xmlns:core="clr-namespace:Bombinha.Core.Settings;assembly=Bombinha.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ===================================================== coluna esquerda -->
            <StackPanel Margin="0,0,18,0">
                <c:Card Header="Modo de jogo" Subtitle="Define como as palavras são escolhidas no dicionário">
                    <UniformGrid Columns="2" Margin="-5">
                        <RadioButton Style="{StaticResource ModeCard}" Content="Palavras longas" c:UiProps.Description="Prioriza tamanho máximo"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEq}, ConverterParameter={x:Static core:GameMode.LongWords}}" />
                        <RadioButton Style="{StaticResource ModeCard}" Content="Palavras curtas" c:UiProps.Description="Mais rápido de digitar"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEq}, ConverterParameter={x:Static core:GameMode.ShortWords}}" />
                        <RadioButton Style="{StaticResource ModeCard}" Content="Qualquer palavra" c:UiProps.Description="Equilíbrio entre as opções"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEq}, ConverterParameter={x:Static core:GameMode.Any}}" />
                        <RadioButton Style="{StaticResource ModeCard}" Content="Modo alfabeto" c:UiProps.Description="Cobre as 23 letras úteis"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEq}, ConverterParameter={x:Static core:GameMode.Alphabet}}" />
                    </UniformGrid>
                </c:Card>

                <c:Card Header="Controle">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button AutomationProperties.AutomationId="StartButton" Style="{StaticResource BtnSuccess}" Content="▶  Iniciar" Padding="34,11" Command="{Binding StartCommand}" />
                            <Button AutomationProperties.AutomationId="StopButton" Style="{StaticResource BtnDanger}" Content="■  Parar  (F8)" Padding="30,11" Margin="10,0,0,0" Command="{Binding StopCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="⟲  Nova partida  (F6)" Command="{Binding NewMatchCommand}" />
                            <Button Content="⟳  Recarregar dicionário" Margin="10,0,0,0" Command="{Binding ReloadDictionaryCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                                   Text="Deixe o jogo visível e sem janelas por cima do campo de digitação. Iniciar também salva as configurações editadas." />
                    </StackPanel>
                </c:Card>

                <c:Card Header="Rodada atual">
                    <StackPanel>
                        <DockPanel Margin="0,4">
                            <Border Width="3" Background="{StaticResource Purple}" CornerRadius="2" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="LETRAS DETECTADAS" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding LiveSyllable}" Style="{StaticResource H2}" FontFamily="{StaticResource Mono}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,8">
                            <Border Width="3" Background="{StaticResource Accent}" CornerRadius="2" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="PALAVRA ESCOLHIDA" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding LiveWord}" Style="{StaticResource H2}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,4">
                            <Border Width="3" Background="{StaticResource TextDim}" CornerRadius="2" Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="ÚLTIMO EVENTO" Style="{StaticResource Caption}" />
                                <TextBlock AutomationProperties.AutomationId="LiveEvent" Text="{Binding LiveEvent}" Style="{StaticResource H2}" Foreground="{StaticResource TextDim}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </c:Card>
            </StackPanel>

            <!-- ===================================================== coluna direita -->
            <StackPanel Grid.Column="1">
                <c:StatTile Caption="PALAVRAS ACEITAS" Value="{Binding SentCount}" Accent="{StaticResource Accent}" />
                <c:StatTile Caption="ACERTOS CONSECUTIVOS" Value="{Binding Streak}" Accent="{StaticResource Success}" Margin="0,14,0,0" />
                <c:StatTile Caption="PALAVRAS NO DICIONÁRIO" Value="{Binding DictionaryCountText}" Accent="{StaticResource Purple}" Margin="0,14,0,0" />

                <c:Card Header="Vida extra" Subtitle="Letras já usadas (K, W e Y não contam)" Margin="0,14,0,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Letters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:LetterChip">
                                    <Border x:Name="Chip" Background="{StaticResource Surface2}" CornerRadius="4" Margin="2" Padding="0,4">
                                        <TextBlock x:Name="Txt" Text="{Binding Letter}" HorizontalAlignment="Center" FontFamily="{StaticResource Mono}"
                                                   FontWeight="Bold" Foreground="{StaticResource TextMute}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Used}" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource Success}" />
                                            <Setter TargetName="Txt" Property="Foreground" Value="#04211A" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding AlphabetProgress}" Style="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                    </StackPanel>
                </c:Card>

                <c:Card Header="Dica">
                    <TextBlock Style="{StaticResource Dim}" FontSize="12"
                               Text="Se o bot enviar em turnos alheios, aumente o limite da barra de turno no Setup. Falsos negativos? Reduza um pouco. Use &quot;Testar detecção&quot; para ver o que o bot enxerga." />
                </c:Card>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
