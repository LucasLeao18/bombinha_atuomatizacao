<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Bombinha.App.Ui"
                    xmlns:c="clr-namespace:Bombinha.App.Ui.Controls">

    <!-- ============================================================ paleta -->
    <SolidColorBrush x:Key="Bg" Color="#0B0E14" />
    <SolidColorBrush x:Key="Sidebar" Color="#0F131C" />
    <SolidColorBrush x:Key="Surface" Color="#141924" />
    <SolidColorBrush x:Key="Surface2" Color="#1B2230" />
    <SolidColorBrush x:Key="Hover" Color="#232C3D" />
    <SolidColorBrush x:Key="Line" Color="#242C3B" />
    <SolidColorBrush x:Key="Text" Color="#E7EBF3" />
    <SolidColorBrush x:Key="TextDim" Color="#98A2B6" />
    <SolidColorBrush x:Key="TextMute" Color="#5F6A7D" />
    <SolidColorBrush x:Key="Accent" Color="#6C8CFF" />
    <SolidColorBrush x:Key="AccentDark" Color="#5878EE" />
    <SolidColorBrush x:Key="Success" Color="#37D399" />
    <SolidColorBrush x:Key="SuccessDark" Color="#2BB886" />
    <SolidColorBrush x:Key="Danger" Color="#FF6B6B" />
    <SolidColorBrush x:Key="DangerDark" Color="#EF5A5A" />
    <SolidColorBrush x:Key="Warn" Color="#FFB454" />
    <SolidColorBrush x:Key="Purple" Color="#B48CFF" />
    <SolidColorBrush x:Key="ConsoleBg" Color="#0A0D14" />
    <SolidColorBrush x:Key="SwitchOff" Color="#2C3546" />
    <SolidColorBrush x:Key="Track" Color="#2A3346" />
    <FontFamily x:Key="Mono">Consolas</FontFamily>

    <!-- ============================================================ conversores -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <ui:PercentConverter x:Key="Percent" />
    <ui:SecondsToMsConverter x:Key="SecToMs" />
    <ui:EnumEqualsConverter x:Key="EnumEq" />
    <ui:EnumVisibilityConverter x:Key="EnumVis" />
    <ui:EmptyToCollapsedConverter x:Key="EmptyCollapsed" />
    <ui:LinesConverter x:Key="Lines" />
    <ui:OptionalPathConverter x:Key="OptionalPath" />
    <ui:InverseBoolConverter x:Key="Not" />

    <!-- ============================================================ texto -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextMute}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Dim" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextMute}" />
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================ botões -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="c:UiProps.Hover" Value="{StaticResource Hover}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{Binding (c:UiProps.Hover), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface2}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Line}" />
                            <Setter Property="Foreground" Value="{StaticResource TextMute}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Btn}" />
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="c:UiProps.Hover" Value="{StaticResource AccentDark}" />
    </Style>
    <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource Success}" />
        <Setter Property="BorderBrush" Value="{StaticResource Success}" />
        <Setter Property="Foreground" Value="#04211A" />
        <Setter Property="c:UiProps.Hover" Value="{StaticResource SuccessDark}" />
    </Style>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
        <Setter Property="Foreground" Value="#2B0A0A" />
        <Setter Property="c:UiProps.Hover" Value="{StaticResource DangerDark}" />
    </Style>
    <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- ============================================================ switch (CheckBox) -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="40" Height="22">
                            <Border x:Name="Track" CornerRadius="11" Background="{StaticResource SwitchOff}" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0" />
                        </Grid>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Text}" />
                            <Setter TargetName="Track" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ segmentado (RadioButton) -->
    <Style x:Key="SegmentHost" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="5" Padding="14,6" Margin="1,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ navegação lateral -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="12,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="6">
                        <DockPanel>
                            <Border x:Name="Bar" Width="3" Background="Transparent" CornerRadius="2" Margin="0,6" />
                            <TextBlock x:Name="Icon" Text="{TemplateBinding c:UiProps.Icon}" Width="34" TextAlignment="Center"
                                       FontSize="14" Foreground="{StaticResource TextMute}" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" Margin="0,10" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Surface}" />
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ cartão de modo de jogo -->
    <Style x:Key="ModeCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                            BorderThickness="2" CornerRadius="8" Padding="14,13">
                        <DockPanel>
                            <Grid Width="14" Height="14" VerticalAlignment="Top" Margin="0,3,12,0">
                                <Ellipse x:Name="Ring" Stroke="#3A4459" StrokeThickness="2" />
                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{StaticResource Accent}" Visibility="Collapsed" />
                            </Grid>
                            <StackPanel>
                                <ContentPresenter TextElement.FontSize="14.5" TextElement.FontWeight="SemiBold" />
                                <TextBlock Text="{TemplateBinding c:UiProps.Description}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Hover}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ slider -->
    <Style x:Key="SliderEdge" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderFill" TargetType="RepeatButton" BasedOn="{StaticResource SliderEdge}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource Accent}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="26" Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource Track}" VerticalAlignment="Center" Margin="2,0" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEdge}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" Stroke="{StaticResource Accent}" StrokeThickness="2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="Width" Value="19" />
                                                    <Setter TargetName="Knob" Property="Height" Value="19" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ campos de texto -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{StaticResource TextMute}"
                                       Margin="{TemplateBinding Padding}" Padding="2,0" IsHitTestVisible="False" Visibility="Collapsed"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ barras de rolagem finas -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="{StaticResource Hover}" CornerRadius="4" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#33405A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Margin="2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEdge}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderEdge}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" Margin="2">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SliderEdge}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SliderEdge}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    </Style>

    <!-- ============================================================ controles próprios -->
    <Style TargetType="c:Card">
        <Setter Property="Margin" Value="0,0,0,18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Card">
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Visibility="{TemplateBinding Header, Converter={StaticResource EmptyCollapsed}}" Margin="0,0,0,12">
                                <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource H2}" />
                                <TextBlock Text="{TemplateBinding Subtitle}" Style="{StaticResource Muted}" Margin="0,3,0,0"
                                           Visibility="{TemplateBinding Subtitle, Converter={StaticResource EmptyCollapsed}}" />
                            </StackPanel>
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:SettingRow">
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SettingRow">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{TemplateBinding Label}" TextWrapping="Wrap" />
                            <TextBlock Text="{TemplateBinding Hint}" Style="{StaticResource Muted}" Margin="0,1,0,0"
                                       Visibility="{TemplateBinding Hint, Converter={StaticResource EmptyCollapsed}}" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:StatTile">
        <Setter Property="Accent" Value="{StaticResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:StatTile">
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="3" Background="{TemplateBinding Accent}" CornerRadius="10,10,0,0" />
                            <StackPanel Margin="16,12,16,14">
                                <TextBlock Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="{TemplateBinding Caption}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:SettingSlider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SettingSlider">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                TickFrequency="{TemplateBinding Step}" IsSnapToTickEnabled="True"
                                SmallChange="{TemplateBinding Step}" LargeChange="{TemplateBinding Step}" IsMoveToPointEnabled="True"
                                Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Text="{TemplateBinding Display}" FontFamily="{StaticResource Mono}"
                                   Width="86" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StepButton" TargetType="RepeatButton">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Delay" Value="400" />
        <Setter Property="Interval" Value="80" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Root" Background="Transparent" Width="30" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:NumericStepper">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:NumericStepper">
                    <Border Style="{StaticResource SegmentHost}" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <RepeatButton x:Name="PART_Down" Content="−" Style="{StaticResource StepButton}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}" Width="44"
                                       TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Mono}" />
                            <RepeatButton x:Name="PART_Up" Content="+" Style="{StaticResource StepButton}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
